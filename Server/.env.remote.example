# Remote pilot service template. Keep the real file private and uncommitted.
ADVENTOUR_REMOTE_MODE=true
ADVENTOUR_DEV_AUTH=false
ADVENTOUR_BIND_HOST=127.0.0.1
PORT=8080
ADVENTOUR_SERVICE_VERSION=pilot-remote-001
DATABASE_URL=postgresql://adventour:password@127.0.0.1:5432/adventour
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service-account.json
