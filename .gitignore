# Environment files are local-only. Commit the matching .example files instead.
.env
.env.*
*.env
*.env.*
!.env.example
!.env.*.example
!*.env.example
!*.env.*.example

# React Native's shared Xcode env file is safe; the .local file is machine-specific.
!/AdventourApp/ios/.xcode.env
/AdventourApp/ios/.xcode.env.local

*.venv

# Local/deployment-only App Engine manifest. Keep secrets out of git.
/Server/app.yaml

