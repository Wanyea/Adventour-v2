# Copy to .env.pilot.local and supply this PC's reachable HTTPS backend for friends.
# For local Android rehearsal only, use http://10.0.2.2:8082 with an isolated backend.
APP_VARIANT=pilot
PILOT_ID=phase2-friends-v1
APP_BUILD_ID=pilot-001
BACKEND_BASE_URL=https://replace-with-pilot-backend.example
API_AUTH_MODE=firebase
GOOGLE_WEB_CLIENT_ID=
# No secrets belong in native build configuration. Enrollment is server-managed.
