# Copy to .env.ios.pilot.local on the Mac used to build the friends pilot.
# The backend must be a reachable HTTPS deployment; do not use localhost or
# the Android emulator address in an iPhone distribution build.
APP_VARIANT=pilot
PILOT_ID=phase2-friends-v1
APP_BUILD_ID=pilot-001
BACKEND_BASE_URL=https://replace-with-pilot-backend.example
API_AUTH_MODE=firebase
GOOGLE_WEB_CLIENT_ID=
# No secrets belong in this file. Firebase iOS setup is supplied through the
# real project's GoogleService-Info.plist and Xcode/Firebase configuration.
